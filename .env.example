# Copy this file to `.env` and fill in the values, then start the stack with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up
#
# Formatting: use KEY=value with NO spaces around `=` and no surrounding quotes.
# A stray space (e.g. `API_TOKEN =abc`) makes the variable name `API_TOKEN ` and
# Docker Compose treats API_TOKEN as unset, so the server fails to load the
# roster on startup and crash-loops instead of coming up.

# ── Required ──────────────────────────────────────────────────────────────────

# Authenticates the server to https://api.15thmeu.org with a 15th MEU API bearer token.
# Obtain a token from the 15th MEU API administrators; keep it server-side.
# The server fetches the roster on startup and exits if this is missing/invalid.
API_TOKEN=your-15thmeu-api-token-here
API_BASE_URL=https://api.15thmeu.org
# For a local API, override with http://host.docker.internal:11000.

# Forum origin for roster-history rank images (no trailing slash).
FORUM_BASE_URL=https://15thmeu.org

# Client/server request gate; the value must match on both sides.
# Exposed as NEXT_PUBLIC_CLIENT_TOKEN in the browser, NOT a private credential.
# Never reuse API_TOKEN or another private credential here.
CLIENT_TOKEN=your-client-request-gate-value

# ── Postgres (required) ──────────────────────────────────────────
# Backs the roster-history diff store and the user-search cache. This is a
# throwaway local database created by the `postgres` service in the compose
# file; this example password is for local development only.
# Production requires a strong URL-safe password.
PG_PASSWORD=cavapps

# How often the background poller snapshots the roster (cron syntax). The default
# (every 15 minutes) is fine; lower it only if you're working on the diff engine.
# DIFF_POLL_SCHEDULE=*/15 * * * *

# ── XenForo forum database (optional) ─────────────────────────────────────────
# Only the roster-history diff viewer and member search read from the live
# XenForo (forum) MariaDB. Leave these blank for local dev. The core roster
# works without them. The diff viewer stays empty; the member-search box returns
# an error rather than results (its index is never built). Fill them in only if
# you have a reachable XenForo database.
# XENFORO_DB_HOST=
# XENFORO_DB_PORT=3306
# XENFORO_DB_USER=
# XENFORO_DB_PASSWORD=
# XENFORO_DB_NAME=xenforo

# ── Client API URLs (optional to override) ────────────────────────────────────
# Production defaults in docker-compose.yml (uncomment to override explicitly):
# NEXT_PUBLIC_DIFF_API_URL=https://bff.apps.15thmeu.org
# NEXT_PUBLIC_USERCACHE_API_URL=https://bff.apps.15thmeu.org/userSearch
# NEXT_PUBLIC_INDIVIDUAL_API_URL=https://bff.apps.15thmeu.org/roster/individual
# The dev overlay defaults these to http://localhost:4000 with the same paths.
# Leave them commented for local Docker development unless overriding deliberately.
